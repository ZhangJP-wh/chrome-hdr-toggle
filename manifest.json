{
  "manifest_version": 3,
  "name": "HDR 开关 / HDR Toggle",
  "version": "1.1.0",
  "minimum_chrome_version": "119",
  "description": "点击图标全局切换 SDR 优先模式；已播放的视频需刷新，特殊播放器可能不支持。",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HDR 开关：点击切换全局 SDR 优先模式",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
